---
# ==========================================
# 1. Server & Security Settings
# ==========================================
timezone: "UTC"
ssh_port: 22
deploy_user: "deploy"

# ==========================================
# 2. Container Registry Auth (GHCR / Docker Hub)
# Set registry_auth_enabled to true for private images
# ==========================================
registry_auth_enabled: false
registry_url: "ghcr.io"
registry_username: ""
registry_token: ""

# ==========================================
# 3. Application Stack (Docker Swarm)
# ==========================================
app_name: "my_web_app"
app_dir: "/opt/app"

# Persistent named volumes (e.g. databases, uploads)
app_named_volumes:
  - "postgres_data"
  # - "redis_data"

# Application services (frontend, backend, database, etc.)
app_services:
  - name: "frontend"
    image: "ghcr.io/username/frontend:latest"
    replicas: 2
    ports:
      - "3000:3000"
    resources:
      reservations:
        cpus: "0.25"
        memory: "128M"
      limits:
        cpus: "0.75"
        memory: "512M"
    env:
      NODE_ENV: "production"
      PORT: "3000"
      NEXT_PUBLIC_API_BASE_URL: "https://api.example.com"
    volumes: []
    depends_on:
      - "backend"

  - name: "backend"
    image: "ghcr.io/username/backend:latest"
    replicas: 2
    ports:
      - "8000:8000"
    resources:
      reservations:
        cpus: "0.25"
        memory: "256M"
      limits:
        cpus: "1.0"
        memory: "768M"
    env:
      DATABASE_URL: "postgresql://postgres:secretpassword@db:5432/appdb"
      PORT: "8000"
    volumes: []
    depends_on:
      - "db"

  - name: "db"
    image: "postgres:17-alpine"
    replicas: 1
    placement_constraints:
      - "node.role == manager"
    resources:
      reservations:
        cpus: "0.25"
        memory: "256M"
      limits:
        cpus: "1.0"
        memory: "1024M"
    env:
      POSTGRES_USER: "postgres"
      POSTGRES_PASSWORD: "secretpassword"
      POSTGRES_DB: "appdb"
    volumes:
      - "postgres_data:/var/lib/postgresql/data"
    depends_on: []
