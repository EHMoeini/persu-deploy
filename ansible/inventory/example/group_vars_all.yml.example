---
# ==========================================
# 1. Server & Security Settings
# ==========================================
timezone: "UTC"
ssh_port: 22
deploy_user: "deploy"

# ==========================================
# 2. Container Registry Auth (GHCR / Docker Hub)
# Set registry_auth_enabled to true for private images
# ==========================================
registry_auth_enabled: false
registry_url: "ghcr.io"
registry_username: ""
registry_token: ""

# ==========================================
# 3. Application Stack (Docker Swarm)
# ==========================================
app_name: "my_web_app"
app_dir: "/opt/app"
docker_swarm_task_history_limit: 1
app_prune_images_until: "24h"

# Persistent named volumes (e.g. databases, uploads)
app_named_volumes:
  - "postgres_data"

# Application services (frontend, backend, database, cache)
app_services:
  - name: "frontend"
    image: "ghcr.io/username/frontend:latest"
    replicas: 2
    auto_update: true
    update_order: "start-first"
    ports:
      - "3000:3000"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:3000/ || exit 1"]
      interval: "15s"
      timeout: "5s"
      retries: 3
      start_period: "25s"
    resources:
      reservations:
        cpus: "0.25"
        memory: "128M"
      limits:
        cpus: "0.75"
        memory: "512M"
    env:
      NODE_ENV: "production"
      PORT: "3000"
      NEXT_PUBLIC_API_BASE_URL: "https://api.example.com"
    volumes: []

  - name: "backend"
    image: "ghcr.io/username/backend:latest"
    replicas: 2
    auto_update: false # Keep false when releases include decoupled DB migrations
    update_order: "start-first"
    ports:
      - "8000:8000"
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/', timeout=3)\" || exit 1"]
      interval: "15s"
      timeout: "5s"
      retries: 3
      start_period: "30s"
    resources:
      reservations:
        cpus: "0.25"
        memory: "256M"
      limits:
        cpus: "1.0"
        memory: "768M"
    env:
      DB_HOST: "db"
      DB_PORT: "5432"
      REDIS_URL: "redis://redis:6379/1"
      DJANGO_BEHIND_PROXY: "true"
      GUNICORN_WORKERS: "3"
    volumes: []

  - name: "db"
    image: "postgres:17-alpine"
    replicas: 1
    auto_update: false
    update_order: "stop-first"
    placement_constraints:
      - "node.role == manager"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-appdb}"]
      interval: "10s"
      timeout: "5s"
      retries: 5
      start_period: "20s"
    resources:
      reservations:
        cpus: "0.25"
        memory: "256M"
      limits:
        cpus: "1.0"
        memory: "1024M"
    env:
      POSTGRES_USER: "postgres"
      POSTGRES_PASSWORD: "secretpassword"
      POSTGRES_DB: "appdb"
    volumes:
      - "postgres_data:/var/lib/postgresql/data"

  - name: "redis"
    image: "redis:7-alpine"
    replicas: 1
    auto_update: false
    update_order: "stop-first"
    placement_constraints:
      - "node.role == manager"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: "10s"
      timeout: "3s"
      retries: 5
    resources:
      reservations:
        cpus: "0.10"
        memory: "64M"
      limits:
        cpus: "0.50"
        memory: "256M"
