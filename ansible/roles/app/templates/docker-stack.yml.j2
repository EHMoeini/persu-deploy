version: "3.8"

services:
{% for service in app_services %}
  {{ service.name }}:
    image: {{ service.image }}
{% if service.command is defined and service.command %}
    command: {{ service.command | to_json }}
{% endif %}
    networks:
      - internal
{% if service.env is defined and service.env %}
    environment:
{% for key, value in service.env.items() %}
      {{ key }}: {{ (value | string) | to_json }}
{% endfor %}
{% endif %}
{% if service.volumes is defined and service.volumes %}
    volumes:
{% for vol in service.volumes %}
      - {{ vol | to_json }}
{% endfor %}
{% endif %}
{% if service.ports is defined and service.ports %}
    ports:
{% for port in service.ports %}
{% if port is mapping %}
      - target: {{ port.target | int }}
        published: {{ port.published | int }}
        protocol: {{ port.protocol | default('tcp') }}
        mode: {{ port.mode | default('ingress') }}
{% else %}
{% set parts = (port | string).split(':') %}
      - target: {{ parts[1] | default(parts[0]) | int }}
        published: {{ parts[0] | int }}
        protocol: tcp
        mode: ingress
{% endif %}
{% endfor %}
{% endif %}
{% if service.healthcheck is defined and service.healthcheck %}
    healthcheck:
      test: {{ service.healthcheck.test | to_json }}
      interval: {{ service.healthcheck.interval | default('15s') }}
      timeout: {{ service.healthcheck.timeout | default('5s') }}
      retries: {{ service.healthcheck.retries | default(3) }}
      start_period: {{ service.healthcheck.start_period | default('30s') }}
{% endif %}
    deploy:
      mode: replicated
      replicas: {{ service.replicas | default(1) | int }}
{% if service.placement_constraints is defined and service.placement_constraints %}
      placement:
        constraints:
{% for constraint in service.placement_constraints %}
          - {{ constraint | to_json }}
{% endfor %}
{% endif %}
{% if service.resources is defined and service.resources %}
      resources:
{% if service.resources.limits is defined %}
        limits:
          cpus: {{ (service.resources.limits.cpus | string) | to_json }}
          memory: {{ service.resources.limits.memory | to_json }}
{% endif %}
{% if service.resources.reservations is defined %}
        reservations:
          cpus: {{ (service.resources.reservations.cpus | string) | to_json }}
          memory: {{ service.resources.reservations.memory | to_json }}
{% endif %}
{% endif %}
      update_config:
        parallelism: {{ service.update_parallelism | default(1) | int }}
        delay: {{ service.update_delay | default('5s') }}
        monitor: {{ service.update_monitor | default('15s') }}
        failure_action: {{ service.update_failure_action | default('rollback') }}
        max_failure_ratio: 0
        order: {{ service.update_order | default('start-first') }}
      rollback_config:
        parallelism: 1
        delay: 5s
        order: {{ service.update_order | default('start-first') }}
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 5
        window: 120s
      labels:
        com.deploykit.managed: "true"
        shepherd.enable: {{ ((service.auto_update | default(false)) | bool | string | lower) | to_json }}
{% if service.labels is defined and service.labels %}
{% for lkey, lval in service.labels.items() %}
        {{ lkey }}: {{ (lval | string) | to_json }}
{% endfor %}
{% endif %}

{% endfor %}
networks:
  internal:
    external: true
    name: {{ app_name }}_internal
{% if app_named_volumes is defined and app_named_volumes | length > 0 %}

volumes:
{% for vol_name in app_named_volumes %}
  {{ vol_name }}:
{% endfor %}
{% endif %}
